<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <queries>
        <!-- Social / Communication -->
        <package android:name="com.whatsapp" />
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.orca" />        <!-- Messenger -->
        <package android:name="com.twitter.android" />       <!-- X -->
        <package android:name="com.snapchat.android" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.discord" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.pinterest" />

        <!-- Browsers / Google apps -->
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.gm" />     <!-- Gmail -->
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.google.android.calendar" />
        <package android:name="com.google.android.apps.docs" />

        <!-- Music / Entertainment -->
        <package android:name="com.spotify.music" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.amazon.avod.thirdpartyclient" /> <!-- Prime Video -->
        <package android:name="in.startv.hotstar" />
        <package android:name="com.google.android.apps.youtube.music" />

        <!-- Shopping / Food / Travel -->
        <package android:name="com.amazon.mShop.android.shopping" />
        <package android:name="in.amazon.mShop.android.shopping" />
        <package android:name="com.flipkart.android" />
        <package android:name="com.application.zomato" />
        <package android:name="in.swiggy.android" />
        <package android:name="com.ubercab" />
        <package android:name="com.olacabs.customer" />
        <package android:name="net.one97.paytm" />
        <package android:name="com.phonepe.app" />
        <package android:name="com.google.android.apps.nbu.paisa.user" /> <!-- Google Pay -->

        <!-- Games -->
        <package android:name="com.dts.freefireth" />        <!-- Free Fire -->
        <package android:name="com.dts.freefiremax" />        <!-- Free Fire MAX -->
        <package android:name="com.tencent.ig" />              <!-- PUBG Mobile -->
        <package android:name="com.pubg.imobile" />            <!-- BGMI -->
        <package android:name="com.activision.callofduty.shooter" /> <!-- COD Mobile -->
        <package android:name="com.supercell.clashofclans" />
        <package android:name="com.supercell.clashroyale" />
        <package android:name="com.mojang.minecraftpe" />
        <package android:name="com.roblox.client" />
        <package android:name="com.miHoYo.GenshinImpact" />

        <!-- Utility -->
        <package android:name="com.android.calculator2" />
        <package android:name="com.android.gallery3d" />
        <package android:name="com.android.camera2" />
    </queries>

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission
        android:name="android.permission.SEND_SMS"
        tools:ignore="SmsAndCallLogPolicy" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.READ_CALL_LOG"
        tools:ignore="SmsAndCallLogPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/img"
        android:label="Friday"
        android:roundIcon="@mipmap/img"
        android:supportsRtl="true"
        android:theme="@style/Theme.Friday">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HomePage"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".UserInfo"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".FridayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <activity
            android:name=".Settings"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ActivityChat"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>