<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E1018"/>
        </shape>
    </item>

    <!-- Left side fade stroke -->
    <item
        android:gravity="left"
        android:width="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@android:color/transparent"
                android:endColor="#C9956A"
                android:angle="270"/>
        </shape>
    </item>

    <!-- Right side fade stroke -->
    <item
        android:gravity="right"
        android:width="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@android:color/transparent"
                android:endColor="#C9956A"
                android:angle="270"/>
        </shape>
    </item>

    <!-- Bottom accent line -->
    <item
        android:top="-400dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="0dp"
        android:height="3dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@android:color/transparent"
                android:centerColor="#E8C4A8"
                android:endColor="@android:color/transparent"
                android:angle="0"/>
        </shape>
    </item>

</layer-list>