<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12090E"
    tools:context=".UserInfo"
    tools:ignore="HardcodedText">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/heading_hud"
        android:paddingTop="48dp"
        android:paddingBottom="18dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Happy!"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="45sp"
            android:textColor="#F7C6C7"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SET UP YOUR PROFILE"
            android:gravity="center"
            android:textSize="10sp"
            android:textColor="#C9956A"
            android:letterSpacing="0.2"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- Avatar -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/img"
            android:padding="16dp"/>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_pencil"
            android:background="@drawable/bg_edit"
            android:padding="4dp"
            android:layout_gravity="bottom|end"/>

    </FrameLayout>

    <TextView
        android:id="@+id/avatarLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOUR AVATAR"
        android:textColor="#6B4040"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/avatarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Name label -->
    <TextView
        android:id="@+id/labelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="FULL NAME"
        android:textColor="#A07060"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/avatarLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Name EditText -->
    <EditText
        android:id="@+id/inputName"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:hint="Enter your name"
        android:paddingStart="16dp"
        android:inputType="textPersonName"
        android:textColor="#E8C4A8"
        android:textColorHint="#6B4040"
        android:textSize="14sp"
        android:background="@drawable/edittext_bg"
        app:layout_constraintTop_toBottomOf="@id/labelName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Number label -->

    <!-- Number EditText -->

    <!-- Save button -->

    <TextView
        android:id="@+id/labelNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:letterSpacing="0.1"
        android:text="MOBILE NUMBER"
        android:textColor="#A07060"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inputName" />

    <EditText
        android:id="@+id/inputNumber"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/edittext_bg"
        android:gravity="center_vertical"
        android:hint="Enter mobile number"
        android:inputType="phone"
        android:paddingStart="16dp"
        android:textColor="#E8C4A8"
        android:textColorHint="#6B4040"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelNumber" />

    <TextView
        android:id="@+id/dob"
        android:layout_width="345dp"
        android:layout_height="0dp"
        android:layout_marginTop="104dp"
        android:letterSpacing="0.1"
        android:text="DATE OF BIRTH"
        android:textColor="#A07060"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintHorizontal_bias="0.484"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inputName" />

    <EditText
        android:id="@+id/inputDOB"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/edittext_bg"
        android:gravity="center_vertical"
        android:hint="Enter your Date of birth"
        android:inputType="phone"
        android:paddingStart="16dp"
        android:textColor="#E8C4A8"
        android:textColorHint="#6B4040"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labelNumber" />

    <Button
        android:id="@+id/saveBtn"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/button_bg"
        android:text="SAVE PROFILE"
        android:textColor="#2B1C1C"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:backgroundTint="@null"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.9"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Privacy note -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOUR DATA IS STORED LOCALLY"
        android:textColor="#3A2030"
        android:textSize="9sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>